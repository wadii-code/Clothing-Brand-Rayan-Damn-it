# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API Keys. Must be the service_role / sb_secret_… key (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /rayan control room.
ADMIN_PASSWORD=

# Public https address of the shop, no trailing slash (used for canonical URLs, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console → Settings → Ownership verification → HTML tag: the content="…" value only.
GOOGLE_SITE_VERIFICATION=
